# One-shot container: pushes the Drizzle schema to MySQL then exits 0.
# docker-compose runs this before the API server starts.
FROM node:24-slim

WORKDIR /app
RUN npm install -g pnpm@10.26.1

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.json tsconfig.base.json ./
COPY lib/db/ ./lib/db/

RUN pnpm install --frozen-lockfile --filter @workspace/db

WORKDIR /app/lib/db
CMD ["pnpm", "push"]
