# One-shot container that pushes the Drizzle schema to MySQL.
# Runs before the API server starts; exits 0 on success.
FROM node:24-alpine

WORKDIR /app
RUN npm install -g pnpm@9

# Workspace manifests
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.json tsconfig.base.json ./

# Only the DB package (schema + drizzle-kit)
COPY lib/db/ ./lib/db/

# Install only @workspace/db and its deps (includes drizzle-kit devDep)
RUN pnpm install --frozen-lockfile --filter @workspace/db --ignore-scripts

WORKDIR /app/lib/db

# drizzle-kit push reads DATABASE_URL from the environment
CMD ["pnpm", "push"]
