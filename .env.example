# ─── Database ─────────────────────────────────────────────────────────────────
# When running locally with docker-compose, use the Docker service name "mysql".
# docker-compose.yml overrides this automatically — just set the passwords below.
DATABASE_URL=mysql://ritual:yourpassword@mysql:3306/ritual_ai

# ─── WhatsApp Cloud API ─────────────────────────────────────────────────────
# From your Meta App dashboard → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EAAG...
# From Meta App dashboard → App Settings → Basic → App Secret.
# Used to verify that incoming webhook calls really came from Meta.
WHATSAPP_APP_SECRET=your-meta-app-secret
# Any random string you choose (e.g. `openssl rand -hex 32`).
# Enter the SAME value in the Meta dashboard's webhook "Verify token" field.
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
# Optional — cosmetic only, shown on the landing page / admin status.
WHATSAPP_DISPLAY_PHONE=+14165551234

# ─── ElevenLabs speech-to-text (optional voice-note input) ────────────────────
# Used to transcribe WhatsApp voice notes. Voice replies are currently disabled.
ELEVENLABS_API_KEY=xi_...
ELEVENLABS_STT_MODEL_ID=scribe_v2

# ─── MySQL passwords (docker-compose reads these) ─────────────────────────────
# Must match the password in DATABASE_URL above.
MYSQL_PASSWORD=yourpassword
MYSQL_ROOT_PASSWORD=yourrootpassword

# ─── Clerk Auth ───────────────────────────────────────────────────────────────
# These come from Replit Secrets AFTER publishing the app on Replit.
# Publishing causes Replit to swap in live keys (pk_live / sk_live).
# Copy the live values from the Replit Secrets pane into this file.
# DO NOT use the pk_test / sk_test dev keys — they only work on Replit's
# own dev domain and will show "Development mode" on any external host.
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
# Must match CLERK_PUBLISHABLE_KEY — baked into the frontend at build time.
# After updating, rebuild the web image: docker compose build web
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AQ...

# ─── App Security ─────────────────────────────────────────────────────────────
# Any long random string (≥32 chars). Used for session signing.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-characters
# Any long random string. Used to hash phone numbers before storing them.
PHONE_PEPPER=another-long-random-string-for-phone-hashing

# ─── Stripe (optional – required for paid plans) ──────────────────────────────
# Get from https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
# Get from https://dashboard.stripe.com → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── App URL (required for WhatsApp magic links) ──────────────────────────────
# The public URL of your deployed app, no trailing slash
APP_URL=https://yourdomain.com

# ─── Admin ────────────────────────────────────────────────────────────────────
# Comma-separated Clerk user IDs that get admin access (from Clerk dashboard)
ADMIN_USER_IDS=user_abc123,user_def456
# Email used for first-run admin bootstrap
ADMIN_BOOTSTRAP_EMAIL=admin@yourdomain.com

# ─── Email / Newsletter (optional – required for newsletters) ─────────────────
# Get from https://resend.com → API Keys
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com
